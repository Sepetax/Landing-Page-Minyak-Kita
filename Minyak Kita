                    <textarea id="alamat" rows="3" required class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-emerald-500 focus:outline-none" placeholder="Nama jalan, nomor rumah, RT/RW, kecamatan atau ketik 'Ambil Sendiri ke Toko'"></textarea>
                </div>

