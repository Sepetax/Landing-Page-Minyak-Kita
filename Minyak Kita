    <!-- Script JavaScript untuk Integrasi WhatsApp -->
    <script>
        function sendToWhatsApp(e) {
            e.preventDefault();
            
            const nama = document.getElementById('nama').value;
            const whatsapp = document.getElementById('whatsapp').value;
            const jumlahDus = document.getElementById('jumlahDus').value;
            const alamat = document.getElementById('alamat').value;

            // Ganti nomor WhatsApp di bawah ini dengan nomor HP Anda (format internasional tanpa angka 0 di depan, misal: 628123456789)
            const nomorAdmin = "6281991840847"; 

            const pesan = `Halo Admin, saya ingin memesan promo Minyak Kita:\n\n` +
                          `*Nama:* ${nama}\n` +
                          `*No WhatsApp:* ${whatsapp}\n` +
                          `*Pesanan:* ${jumlahDus}\n` +
                          `*Alamat/Catatan:* ${alamat}\n\n` +
                          `Mohon info kelanjutan pembayarannya. Terima kasih!`;

            const url = `https://wa.me/${nomorAdmin}?text=${encodeURIComponent(pesan)}`;
            window.open(url, '_blank');
        }
    </script>
